# ==============================================================================
# MediTrail — Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' for local development:
#   PowerShell: Copy-Item .env.example .env
#   Command Prompt / Bash: cp .env.example .env
#
# IMPORTANT:
# - Never commit your real '.env' file or production credentials to Git.
# - Do NOT put real secrets into this '.env.example' template.
# - runner.py automatically loads '.env' into both Python and Java processes.
# - Existing shell environment variables always take precedence over '.env'.
# ==============================================================================

# ── 1. Brevo Transactional Email API (Real-Time Patient Sign-In OTP) ─────────
# Generated in Brevo Dashboard > SMTP & API > API Keys:
BREVO_API_KEY=your_brevo_api_key_here

# Must be a verified sender address in Brevo Dashboard > Senders & IP > Senders:
BREVO_SENDER_EMAIL=your_verified_sender_email@yourdomain.com

# Optional display sender name (defaults to "MediTrail"):
BREVO_SENDER_NAME=MediTrail

# Optional: Associate a real, accessible test email with demo patient Dev Mandora (MT-26926) for local testing.
# Must be unique; cannot overwrite any existing patient account. Leave empty to leave demo account unlinked.
# DEMO_PATIENT_EMAIL=your_real_test_email@example.com

# ── 2. Cloudflare R2 Persistent Object Storage (Insurance Policy PDFs) ───────
# In Cloudflare Dashboard > R2 Overview > Account Details:
R2_ACCOUNT_ID=your_cloudflare_account_id_here

# From the R2 API Token screen created with Object Read & Write permissions:
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here

# Your existing private bucket name:
R2_BUCKET_NAME=meditrail

# Optional custom S3 endpoint. If omitted, runner.py / Java automatically derives:
# https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=https://435c56d41181e0a6801e630e2c8bd30e.r2.cloudflarestorage.com

# ── 2. Server & Networking Configuration ──────────────────────────────────────
# Frontend web server port (default 8000)
FRONTEND_PORT=8000

# Java backend REST API port (default 8080)
API_PORT=8080

# Environment profile ("development" or "production")
ENV=development

# Host interface binding ("0.0.0.0" allows local & container connections)
HOST=0.0.0.0

# ── 3. Database Configuration ─────────────────────────────────────────────────
# Database engine: "h2" for local development, "postgres" for production
DB_TYPE=h2

# H2 file database uses a safe local default in backend/java-server/data/
# For PostgreSQL deployment, supply: jdbc:postgresql://<host>:<port>/<dbname>
# DB_URL=jdbc:postgresql://localhost:5432/meditrail
# DB_USER=postgres
# DB_PASSWORD=your_postgres_password_here

# Automatically seed demo patient accounts (true for development, false for prod)
SEED_DEMO_DATA=true

# ── 4. CORS Allowed Origins (Comma-separated) ─────────────────────────────────
# ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ============================================================
# TEMPORARY NEON POSTGRESQL TESTING
# Copy these settings into your local .env only when testing Neon.
# Restore DB_TYPE=h2 after testing to resume normal local development.
# Never commit actual database credentials.
# ============================================================

# Set to postgres only for the Neon connection test
DB_TYPE=postgres

# Paste your Neon connection string here
DATABASE_URL=

# Leave these empty if your connection string/configuration already
# provides the required credentials. Otherwise, fill them in privately.
DB_USER=
DB_PASSWORD=

# Keep demo seeding disabled during the initial Neon connection test
SEED_DEMO_DATA=false

